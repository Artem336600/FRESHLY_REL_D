{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install flask gunicorn"
  },
  "deploy": {
    "startCommand": "chmod +x run_minimal.sh && ./run_minimal.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
} 